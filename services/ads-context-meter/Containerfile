FROM python:3.12-slim-bookworm AS builder
COPY --from=ghcr.io/astral-sh/uv:0.10.12 /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv
COPY pyproject.toml README.md uv.lock /app/
COPY libraries /app/libraries
COPY services /app/services
RUN uv sync --frozen --package ads-context-meter --no-dev --no-default-groups --no-editable
RUN /app/.venv/bin/python -m ads_context_meter.bake /opt/tokenizers

FROM python:3.12-slim-bookworm
RUN apt-get update \
    && apt-get install -y --no-install-recommends libseccomp2 \
    && rm -rf /var/lib/apt/lists/* \
    && adduser --disabled-password --gecos "" --uid 1000 ads \
    && mkdir -p /app \
    && chown ads:ads /app
COPY --from=builder --chown=ads:ads /app/.venv /app/.venv
COPY --from=builder /opt/tokenizers /opt/tokenizers
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    ADS_CONTEXT_METER_TOKENIZER_DIRECTORY=/opt/tokenizers \
    LITELLM_LOCAL_MODEL_COST_MAP=True \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    TOKENIZERS_PARALLELISM=false
USER 1000
WORKDIR /app
EXPOSE 8080
CMD ["python", "-m", "ads_context_meter"]
