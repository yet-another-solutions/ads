FROM python:3.12-slim-bookworm
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        iproute2 wireguard-tools nftables tcpdump iputils-ping iputils-arping \
        procps util-linux ca-certificates e2fsprogs \
    && rm -rf /var/lib/apt/lists/*
COPY services/ads-ptp-tools/ads-ptp-canary /usr/local/bin/ads-ptp-canary
COPY services/ads-ptp-tools/ads-ptp /usr/local/bin/ads-ptp
COPY services/ads-ptp-tools/ads-ptp-relay /usr/local/bin/ads-ptp-relay
COPY services/ads-ptp-tools/ads-ptp-attest /usr/local/bin/ads-ptp-attest
COPY services/ads-ptp-tools/ads-ptp-retire /usr/local/bin/ads-ptp-retire
COPY services/ads-ptp-tools/ads-ptp-release /usr/local/bin/ads-ptp-release
COPY services/ads-ptp-tools/ads-ptp-partial /usr/local/bin/ads-ptp-partial
COPY services/ads-ptp-tools/ads-ipc-release /usr/local/bin/ads-ipc-release
COPY services/ads-ptp-tools/ads-ipc-storage /usr/local/bin/ads-ipc-storage
COPY services/ads-ptp-tools/ads-block-release /usr/local/bin/ads-block-release
COPY services/ads-ptp-tools/ads-node-owner /usr/local/bin/ads-node-owner
RUN chmod 755 /usr/local/bin/ads-ptp-canary /usr/local/bin/ads-ptp /usr/local/bin/ads-ptp-relay /usr/local/bin/ads-ptp-attest /usr/local/bin/ads-ptp-retire /usr/local/bin/ads-ptp-release /usr/local/bin/ads-ptp-partial /usr/local/bin/ads-ipc-release /usr/local/bin/ads-node-owner
ENV PYTHONUNBUFFERED=1
RUN chmod 755 /usr/local/bin/ads-ipc-storage /usr/local/bin/ads-block-release
CMD ["python", "-c", "import time; time.sleep(86400)"]
