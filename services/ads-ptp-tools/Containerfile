FROM python:3.12-slim-bookworm
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        iproute2 wireguard-tools nftables tcpdump iputils-ping iputils-arping \
        procps util-linux ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY services/ads-ptp-tools/ads-ptp-canary /usr/local/bin/ads-ptp-canary
COPY services/ads-ptp-tools/ads-ptp /usr/local/bin/ads-ptp
COPY services/ads-ptp-tools/ads-ptp-relay /usr/local/bin/ads-ptp-relay
COPY services/ads-ptp-tools/ads-ptp-attest /usr/local/bin/ads-ptp-attest
COPY services/ads-ptp-tools/ads-ptp-retire /usr/local/bin/ads-ptp-retire
COPY services/ads-ptp-tools/ads-ptp-release /usr/local/bin/ads-ptp-release
COPY services/ads-ptp-tools/ads-ipc-release /usr/local/bin/ads-ipc-release
RUN chmod 755 /usr/local/bin/ads-ptp-canary /usr/local/bin/ads-ptp /usr/local/bin/ads-ptp-relay /usr/local/bin/ads-ptp-attest /usr/local/bin/ads-ptp-retire /usr/local/bin/ads-ptp-release /usr/local/bin/ads-ipc-release
ENV PYTHONUNBUFFERED=1
CMD ["python", "-c", "import time; time.sleep(86400)"]
