#!/usr/bin/env python3
"""Detect the one live local CRI socket. No configured endpoint."""

from __future__ import annotations

import os
import stat
import subprocess
import sys
from pathlib import Path

PROBES = (
    "unix:///run/containerd/containerd.sock",
    "unix:///var/run/crio/crio.sock",
)
RUNTIME_ID = r"(containerd|cri-o)://[0-9a-f]{64}"


def require(value, message):
    if not value:
        raise ValueError(message)


def socket_path(endpoint):
    require(isinstance(endpoint, str) and endpoint.startswith("unix:///"), "local CRI required")
    path = Path(endpoint.removeprefix("unix://"))
    require(path.is_absolute() and path == path.resolve(), "canonical CRI path required")
    return path


def is_socket(path):
    try:
        info = path.lstat()
    except OSError:
        return False
    return stat.S_ISSOCK(info.st_mode) and not stat.S_ISLNK(info.st_mode)


def answers(crictl, endpoint):
    try:
        reply = subprocess.run(
            [str(crictl), "--runtime-endpoint=" + endpoint, "--timeout=3s", "version", "-o", "json"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=4,
            env={
                "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
                "LANG": "C",
                "HOME": "/nonexistent",
            },
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return reply.returncode == 0


def detect(crictl):
    """Exactly one probe must be a socket that answers crictl."""
    path = Path(crictl)
    info = path.lstat()
    require(
        path.is_absolute()
        and path.resolve() == path
        and stat.S_ISREG(info.st_mode)
        and info.st_uid == 0
        and not info.st_mode & 0o022
        and info.st_mode & 0o111,
        "protected crictl required",
    )
    winners = []
    for endpoint in PROBES:
        candidate = socket_path(endpoint)
        if not is_socket(candidate):
            continue
        if not answers(path, endpoint):
            raise ValueError("CRI socket did not answer crictl")
        winners.append(endpoint)
    require(len(winners) == 1, "exactly one live CRI socket required")
    return winners[0]


def main():
    require(os.geteuid() == 0, "node-root CRI detection required")
    require(len(sys.argv) == 2, "one protected crictl path required")
    print(detect(sys.argv[1]))


if __name__ == "__main__":
    main()
