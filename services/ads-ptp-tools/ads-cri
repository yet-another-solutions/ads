#!/usr/bin/env python3
"""CRI v1 gRPC client for a local unix socket.

Calls RuntimeService through grpcio with the vendored cri-api 1.36 stubs
(cri_api_1_36_pb2 / cri_api_1_36_pb2_grpc) and translates responses into
plain dicts matching the crictl JSON contract. Runs only inside the
ads-ptp-tools image: grpcio and protobuf are installed there, and worker
hosts never execute this file (the host CNI plugin copies only ads-ptp
and speaks to the attestor over its own socket).
"""

from __future__ import annotations

import importlib.machinery
import importlib.util
import json
import os
import stat
import sys
import time
from pathlib import Path

import grpc

LIMIT = 4194304
SOCKETS = (
    "/run/containerd/containerd.sock",
    "/run/crio/crio.sock",
)
RUNTIME_ID = r"(containerd|cri-o)://[0-9a-f]{64}"
METHODS = (
    "Version",
    "ListPodSandbox",
    "PodSandboxStatus",
    "ListContainers",
    "ContainerStatus",
)

POD_SANDBOX_STATES = {0: "SANDBOX_READY", 1: "SANDBOX_NOTREADY"}
CONTAINER_STATES = {
    0: "CONTAINER_CREATED",
    1: "CONTAINER_RUNNING",
    2: "CONTAINER_EXITED",
    3: "CONTAINER_UNKNOWN",
}


def require(value, message):
    if not value:
        raise ValueError(message)


def load(name):
    path = Path(__file__).with_name(name)
    if not path.exists() and path.with_suffix(".py").exists():
        path = path.with_suffix(".py")
    module = sys.modules.get(name)
    if module is not None and getattr(module, "__file__", None) == str(path):
        return module
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


def socket_path(endpoint):
    require(
        isinstance(endpoint, str) and endpoint.startswith("unix://"),
        "local CRI endpoint required",
    )
    path = Path(endpoint.removeprefix("unix://"))
    require(path.is_absolute() and path == path.resolve(), "canonical CRI path required")
    return path


def is_socket(path):
    try:
        info = path.lstat()
    except OSError:
        return False
    return stat.S_ISSOCK(info.st_mode) and not stat.S_ISLNK(info.st_mode)


def detect():
    """Exactly one probe must be a live CRI socket. Returns unix:// endpoint."""
    winners = []
    for candidate in SOCKETS:
        path = Path(candidate)
        require(path.is_absolute(), "absolute CRI socket path required")
        if is_socket(path):  # lstat: symlinks are not sockets, so skipped
            # A live socket at a non-canonical alias (e.g. /var/run/...) is
            # rejected loudly instead of returned to fail later downstream.
            require(path == path.resolve(), "canonical CRI socket path required")
            winners.append("unix://" + candidate)
    require(len(winners) == 1, "exactly one live CRI socket required")
    return winners[0]


def sandbox_state_name(value):
    require(value in POD_SANDBOX_STATES, "unknown CRI sandbox state")
    return POD_SANDBOX_STATES[value]


def container_state_name(value):
    require(value in CONTAINER_STATES, "unknown CRI container state")
    return CONTAINER_STATES[value]


def _metadata(name, uid="", namespace="", attempt=0):
    # Containers carry only ContainerMetadata (name/attempt); uid and
    # namespace stay empty strings exactly as the crictl JSON contract shows.
    return {"uid": uid, "name": name, "namespace": namespace, "attempt": attempt}


def _info_map(entries):
    out = {}
    for key, value in entries.items():
        try:
            out[key] = json.loads(value)
        except (json.JSONDecodeError, TypeError):
            out[key] = value
    # containerd verbose responses nest every info entry under one "info" key
    # (its own Info map); flatten that single-entry wrapper to the crictl shape.
    nested = out.get("info")
    if isinstance(nested, dict):
        for key, value in nested.items():
            out.setdefault(key, value)
        del out["info"]
    return out


class Cri:
    """Read-only RuntimeService surface matching the crictl JSON contract."""

    def __init__(self, endpoint=None, deadline=None):
        self.endpoint = endpoint or detect()
        self.deadline = deadline or time.monotonic() + 10
        self.api = load("cri_api_1_36_pb2")
        self.stubs = load("cri_api_1_36_pb2_grpc")
        self.channel = None

    def _connect(self):
        if self.channel is None:
            self.channel = grpc.insecure_channel("unix://" + str(socket_path(self.endpoint)))
        return self.channel

    def _rpc(self, method, request):
        require(self.deadline - time.monotonic() > 0, "cri deadline exceeded")
        stub = self.stubs.RuntimeServiceStub(self._connect())
        try:
            return getattr(stub, method)(
                request, timeout=max(0.05, self.deadline - time.monotonic())
            )
        except grpc.RpcError as error:
            require(False, "cri rpc failed: " + (error.details() or "unknown"))

    def call(self, method, request):
        require(method in METHODS, "unsupported CRI rpc")
        return self._rpc(method, request)

    # Read-only JSON-shaped queries matching the crictl output contract.

    def pods(self):
        reply = self._rpc("ListPodSandbox", self.api.ListPodSandboxRequest())
        return [
            {
                "id": item.id,
                "state": sandbox_state_name(item.state),
                "createdAt": item.created_at,
                "metadata": _metadata(
                    item.metadata.name,
                    uid=item.metadata.uid,
                    namespace=item.metadata.namespace,
                    attempt=item.metadata.attempt,
                ),
                "labels": dict(item.labels),
                "annotations": dict(item.annotations),
                "runtimeHandler": item.runtime_handler,
            }
            for item in reply.items
        ]

    def inspectp(self, sandbox_id):
        reply = self._rpc(
            "PodSandboxStatus",
            self.api.PodSandboxStatusRequest(pod_sandbox_id=sandbox_id, verbose=True),
        )
        status = reply.status
        return {
            "status": {
                "id": status.id,
                "state": sandbox_state_name(status.state),
                "createdAt": status.created_at,
                "metadata": _metadata(
                    status.metadata.name,
                    uid=status.metadata.uid,
                    namespace=status.metadata.namespace,
                    attempt=status.metadata.attempt,
                ),
                "labels": dict(status.labels),
                "annotations": dict(status.annotations),
                "runtimeHandler": status.runtime_handler,
            },
            "info": _info_map(reply.info),
        }

    def containers(self):
        reply = self._rpc("ListContainers", self.api.ListContainersRequest())
        return [
            {
                "id": item.id,
                "podSandboxId": item.pod_sandbox_id,
                "state": container_state_name(item.state),
                "createdAt": item.created_at,
                "metadata": _metadata(item.metadata.name, attempt=item.metadata.attempt),
                "image": {"image": item.image.image},
                "imageRef": item.image_ref,
                "labels": dict(item.labels),
                "annotations": dict(item.annotations),
            }
            for item in reply.containers
        ]

    def inspect(self, container_id):
        reply = self._rpc(
            "ContainerStatus",
            self.api.ContainerStatusRequest(container_id=container_id, verbose=True),
        )
        status = reply.status
        return {
            "status": {
                "id": status.id,
                "state": container_state_name(status.state),
                "createdAt": status.created_at,
                "metadata": _metadata(status.metadata.name, attempt=status.metadata.attempt),
                "imageRef": status.image_ref,
                "labels": dict(status.labels),
                "annotations": dict(status.annotations),
            },
            "info": _info_map(reply.info),
        }


def probe(endpoint=None, timeout=4):
    """Answer-check: Version rpc must succeed within the timeout."""
    client = Cri(endpoint, time.monotonic() + timeout)
    reply = client.call("Version", client.api.VersionRequest(version="0.1.0"))
    require(reply.runtime_name in ("containerd", "cri-o"), "unexpected cri runtime")
    return client.endpoint


def main():
    require(os.geteuid() == 0, "node-root CRI detection required")
    require(len(sys.argv) == 1, "no arguments required")
    print(probe(timeout=4))


if __name__ == "__main__":
    main()
