#!/usr/bin/env python3
"""Node-root mTLS boundary for fixed release helpers, never a remote shell."""

from __future__ import annotations

import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import socket
import ssl
import stat
import subprocess
import sys
import tempfile
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from uuid import UUID

LIMIT = 32768
SCHEMA = "ads-node-owner-v1"
OPERATIONS = {
    "pair-capture",
    "pair-observe",
    "ipc-capture",
    "ipc-observe",
    "partial-capture",
    "partial-observe",
    "ipc-storage-capture",
    "ipc-storage-observe",
    "ipc-unused-capture",
    "ipc-unused-observe",
    "block-capture",
    "block-observe",
}


def require(value, message):
    if not value:
        raise ValueError(message)


def load(name):
    loader = importlib.machinery.SourceFileLoader(
        name.replace("-", "_"), str(Path(__file__).with_name(name))
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def protected(path, *, private=False, executable=False):
    path = Path(path)
    info = path.lstat()
    require(
        path.is_absolute()
        and path.resolve() == path
        and stat.S_ISREG(info.st_mode)
        and info.st_uid == 0
        and not info.st_mode & (0o077 if private else 0o022)
        and (not executable or info.st_mode & 0o111),
        "protected node-owned file required",
    )
    for parent in path.parents:
        info = parent.stat()
        require(
            info.st_uid == 0 and not info.st_mode & 0o022,
            "protected node-owned parent directory required",
        )
    return path


def settings(path):
    for name in (
        "ads-ptp",
        "ads-ptp-attest",
        "ads-ptp-retire",
        "ads-ptp-release",
        "ads-ptp-partial",
        "ads-ipc-release",
        "ads-ipc-storage",
        "ads-block-release",
        "ads-node-owner",
    ):
        protected(Path(__file__).with_name(name), executable=True)
    value = load("ads-ptp").read_record(protected(path, private=True))
    require(
        isinstance(value, dict)
        and set(value)
        == {
            "node",
            "namespace",
            "network",
            "bind",
            "port",
            "ca",
            "certificate",
            "key",
            "manager_fingerprints",
            "pair",
            "ipc",
        },
        "exact node service configuration required",
    )
    for key in ("node", "namespace", "network"):
        require(
            isinstance(value[key], str) and re.fullmatch(r"[a-z0-9][a-z0-9.-]{0,252}", value[key]),
            "invalid node service scope",
        )
    require(
        isinstance(value["bind"], str)
        and value["bind"]
        and type(value["port"]) is int
        and 1 <= value["port"] <= 65535,
        "explicit node listener required",
    )
    pins = value["manager_fingerprints"]
    require(
        isinstance(pins, list)
        and 1 <= len(pins) <= 2
        and all(isinstance(p, str) and re.fullmatch(r"[0-9a-f]{64}", p) for p in pins)
        and len(set(pins)) == len(pins),
        "one manager identity and optional rotation identity required",
    )
    for key in ("ca", "certificate", "key"):
        protected(value[key], private=key == "key")
    require(value["pair"] is not None or value["ipc"] is not None, "one node role required")
    if value["pair"] is not None:
        pair = value["pair"]
        require(
            isinstance(pair, dict)
            and set(pair)
            in (
                {"attestorConfig", "stateDir"},
                {"attestorConfig", "stateDir", "kubeletRoot"},
            ),
            "exact pair observer configuration required",
        )
        plugin, attestor = load("ads-ptp"), load("ads-ptp-attest")
        config = attestor.validate(
            plugin.read_record(protected(pair["attestorConfig"], private=True))
        )
        require(
            all(config[k] == value[k] for k in ("node", "namespace", "network")),
            "pair scope mismatch",
        )
        plugin.private_directory(pair["stateDir"])
        if "kubeletRoot" in pair:
            load("ads-block-release").kubelet_root(pair["kubeletRoot"])
    if value["ipc"] is not None:
        ipc = load("ads-ipc-release")
        config = ipc.config(load("ads-ptp").read_record(protected(value["ipc"], private=True)))
        require(all(config[k] == value[k] for k in ("node", "namespace")), "IPC scope mismatch")
    return value


def request(raw, config):
    require(isinstance(raw, bytes) and 0 < len(raw) <= LIMIT, "bounded request required")
    value = load("ads-ptp").decode(raw)
    require(
        isinstance(value, dict)
        and set(value)
        == {
            "schema",
            "nonce",
            "operation",
            "node",
            "namespace",
            "network",
            "generation",
            "sandbox_id",
            "pod_uid",
            "volume_uid",
            "boot_id",
            "inventory_sha256",
        }
        | (
            {"pod_uids"}
            if value.get("operation") in ("partial-capture", "partial-observe")
            else set()
        )
        | (
            {"volumes", "runtime_sha256"}
            if value.get("operation") in ("block-capture", "block-observe")
            else set()
        )
        | (
            {"pv_uid"}
            if value.get("operation") in ("ipc-unused-capture", "ipc-unused-observe")
            else set()
        ),
        "exact node request required",
    )
    require(
        value["schema"] == SCHEMA
        and value["operation"] in OPERATIONS
        and all(value[k] == config[k] for k in ("node", "namespace", "network")),
        "node request scope mismatch",
    )
    for key in ("nonce", "generation", "sandbox_id"):
        require(
            isinstance(value[key], str) and str(UUID(value[key])) == value[key],
            "canonical request identity required",
        )
    ipc = value["operation"].startswith("ipc-")
    unused = value["operation"].startswith("ipc-unused-")
    require(config["ipc" if ipc else "pair"] is not None, "node role unavailable")
    if value["operation"].startswith("partial-"):
        load("ads-ptp-partial").pod_map(value["pod_uids"])
    if value["operation"].startswith("block-"):
        require("kubeletRoot" in config["pair"], "original kubelet root configuration required")
        load("ads-block-release").names(value["volumes"])
        require(
            isinstance(value["runtime_sha256"], str)
            and re.fullmatch(r"[0-9a-f]{64}", value["runtime_sha256"]),
            "original private runtime capture binding required",
        )
    for key in ("pod_uid", "volume_uid", *(("pv_uid",) if unused else ())):
        require(
            isinstance(value[key], str) and str(UUID(value[key])) == value[key]
            if ipc and not (unused and key == "pod_uid")
            else value[key] is None,
            "exact IPC ownership required",
        )
    if value["operation"].endswith("observe"):
        require(
            isinstance(value["boot_id"], str)
            and str(UUID(value["boot_id"])) == value["boot_id"]
            and isinstance(value["inventory_sha256"], str)
            and re.fullmatch(r"[0-9a-f]{64}", value["inventory_sha256"]),
            "original observation binding required",
        )
    else:
        require(
            value["boot_id"] is None and value["inventory_sha256"] is None,
            "capture cannot replace original binding",
        )
    return value


def helper(name, payload):
    # Names below are compiled-in. No request supplies any argv, executable,
    # environment, path, credentials, namespace selector or shell fragment.
    path = protected(Path(__file__).with_name(name), executable=True)
    with tempfile.TemporaryFile() as output:
        result = subprocess.run(
            [str(path)],
            input=json.dumps(payload).encode(),
            stdout=output,
            stderr=subprocess.DEVNULL,
            timeout=5 if name == "ads-ptp-retire" else 65,
            env={
                "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
                "LANG": "C",
                "HOME": "/nonexistent",
            },
        )
        require(result.returncode == 0 and 0 < output.tell() <= LIMIT, "node observation failed")
        output.seek(0)
        return load("ads-ptp").decode(output.read(LIMIT + 1))


def perform(raw, config):
    value = request(raw, config)
    identity = {key: value[key] for key in ("generation", "sandbox_id")}
    capture = value["operation"].endswith("capture")
    if value["operation"].startswith("ipc-unused-"):
        report = helper(
            "ads-ipc-storage",
            {
                **identity,
                "action": "unused-capture" if capture else "unused-observe",
                "config": config["ipc"],
                **{key: value[key] for key in ("volume_uid", "pv_uid", "inventory_sha256")},
            },
        )
    elif value["operation"].startswith("ipc-"):
        report = helper(
            "ads-ipc-storage"
            if value["operation"].startswith("ipc-storage-")
            else "ads-ipc-release",
            {
                **identity,
                "action": "capture" if capture else "observe",
                "config": config["ipc"],
                **{key: value[key] for key in ("pod_uid", "volume_uid", "inventory_sha256")},
            },
        )
    elif value["operation"].startswith("block-"):
        report = helper(
            "ads-block-release",
            {
                **identity,
                **config["pair"],
                "action": "capture" if capture else "observe",
                **{k: value[k] for k in ("volumes", "runtime_sha256", "inventory_sha256")},
            },
        )
    else:
        if capture:
            helper(
                "ads-ptp-retire",
                {
                    **identity,
                    "network": config["network"],
                    "stateDir": config["pair"]["stateDir"],
                },
            )
        partial = value["operation"].startswith("partial-")
        report = helper(
            "ads-ptp-partial" if partial else "ads-ptp-release",
            {
                **identity,
                **{key: config["pair"][key] for key in ("attestorConfig", "stateDir")},
                "action": "capture" if capture else "observe",
                **({"pod_uids": value["pod_uids"]} if partial else {}),
            },
        )
    require(
        isinstance(report, dict)
        and all(
            report.get(k) == value[k] for k in ("node", "namespace", "generation", "sandbox_id")
        )
        and (capture or all(report.get(k) == value[k] for k in ("boot_id", "inventory_sha256"))),
        "helper returned a different inventory",
    )
    return {
        "schema": SCHEMA,
        "nonce": value["nonce"],
        "request_sha256": hashlib.sha256(raw).hexdigest(),
        "report": report,
    }


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *args):
        pass  # No untrusted request, private helper output or certificate logs.

    def do_POST(self):
        self.close_connection = True
        try:
            certificate = self.connection.getpeercert(binary_form=True)
            require(
                hashlib.sha256(certificate).hexdigest()
                in self.server.config["manager_fingerprints"],
                "unexpected authenticated client",
            )
            lengths = self.headers.get_all("Content-Length", [])
            require(
                self.path == "/v1/observe"
                and len(lengths) == 1
                and re.fullmatch(r"[1-9][0-9]{0,4}", lengths[0])
                and int(lengths[0]) <= LIMIT
                and self.headers.get_all("Content-Type", []) == ["application/json"]
                and not self.headers.get_all("Transfer-Encoding")
                and not self.headers.get_all("Content-Encoding")
                and not self.headers.get_all("Expect"),
                "bounded fixed HTTP operation required",
            )
            raw = self.rfile.read(int(lengths[0]))
            require(len(raw) == int(lengths[0]), "truncated request")
            output = json.dumps(perform(raw, self.server.config)).encode()
            require(len(output) <= LIMIT, "response exceeds bound")
            status = 200
        except Exception:
            output, status = b'{"error":"node observation unavailable"}', 503
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(output)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(output)

    def handle_expect_100(self):
        self.send_error(417)
        return False


class Server(ThreadingHTTPServer):
    daemon_threads = False
    block_on_close = True
    request_queue_size = 4

    def __init__(self, config, context):
        self.config, self.context = config, context
        self.slots = threading.BoundedSemaphore(4)
        super().__init__((config["bind"], config["port"]), Handler)

    def process_request(self, connection, address):
        if not self.slots.acquire(blocking=False):
            self.shutdown_request(connection)
            return
        try:
            super().process_request(connection, address)
        except BaseException:
            self.slots.release()
            raise

    def process_request_thread(self, connection, address):
        try:
            connection.settimeout(10)
            # TLS handshake occurs in a bounded worker, not the accept loop.
            with self.context.wrap_socket(connection, server_side=True) as secured:
                # Socket timeouts alone permit indefinitely slow header drips.
                # Closing this authenticated exchange does not erase any helper
                # fence/capture already committed; a later request must retry it.
                def expire():
                    try:
                        secured.shutdown(socket.SHUT_RDWR)
                    except OSError:
                        pass

                timer = threading.Timer(75, expire)
                timer.daemon = True
                timer.start()
                try:
                    self.finish_request(secured, address)
                finally:
                    timer.cancel()
        except (TimeoutError, OSError, ssl.SSLError):
            pass
        finally:
            self.shutdown_request(connection)
            self.slots.release()


def context(config):
    result = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    result.minimum_version = ssl.TLSVersion.TLSv1_3
    result.verify_mode = ssl.CERT_REQUIRED
    result.load_verify_locations(cafile=config["ca"])
    result.load_cert_chain(config["certificate"], config["key"])
    return result


def main():
    require(os.geteuid() == 0, "actual node-root service required")
    require(len(sys.argv) == 2, "one protected platform configuration required")
    config = settings(sys.argv[1])
    with Server(config, context(config)) as server:
        server.serve_forever(poll_interval=0.5)


if __name__ == "__main__":
    main()
