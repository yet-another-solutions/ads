#!/usr/bin/env python3
"""Node-root, on-demand Kubernetes/CRI attestation. The socket listener does not mutate links."""

from __future__ import annotations

import contextlib
import fcntl
import importlib.machinery
import importlib.util
import json
import os
import re
import select
import socket
import ssl
import stat
import subprocess
import sys
import tempfile
import time
import urllib.parse
import urllib.request
from pathlib import Path
from uuid import UUID

COMPONENT = "app.kubernetes.io/component"
LABELS = (
    "ads.io/session-id",
    "ads.io/sandbox-id",
    "ads.io/project-id",
    "ads.io/attachment-generation",
)
FIELDS = {
    "node",
    "namespace",
    "network",
    "apiServer",
    "token",
    "apiCa",
    "relay_image",
    "relay_container",
    "guest_runtime",
    "egress_runtime",
    "transport_mtu",
    "attestorSocket",
    "cniCN",
    "nodeOwnerSocket",
    "nodeOwnerCN",
    "ca",
    "certificate",
    "key",
}


def require(value, message):
    if not value:
        raise ValueError(message)


def cni_module():
    path = Path(__file__).with_name("ads-ptp")
    loader = importlib.machinery.SourceFileLoader("ads_ptp_attestation_cni", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def validate(config):
    require(isinstance(config, dict) and set(config) == FIELDS, "exact node configuration required")
    for name in (
        "node",
        "namespace",
        "network",
        "relay_container",
        "guest_runtime",
        "egress_runtime",
    ):
        require(
            isinstance(config[name], str)
            and re.fullmatch(r"[a-z0-9][a-z0-9.-]{0,252}", config[name]),
            "invalid platform name",
        )
    require(
        type(config["transport_mtu"]) is int and 686 <= config["transport_mtu"] <= 65535,
        "invalid path MTU",
    )
    require(
        isinstance(config["relay_image"], str)
        and 0 < len(config["relay_image"]) <= 512
        and not any(c.isspace() for c in config["relay_image"]),
        "invalid relay image",
    )
    require(
        isinstance(config["apiServer"], str)
        and config["apiServer"].startswith("https://")
        and len(config["apiServer"]) <= 253
        and not config["apiServer"].endswith("/"),
        "verified HTTPS Kubernetes API endpoint required",
    )
    # The projected service-account volume is the only supported credential
    # source: kubelet-rotated token read at call time, cluster CA for verified
    # TLS. No kubeconfig, no exec plugin, no host kube tooling. The CRI
    # endpoint is a detected local socket, never a configured executable.
    for name in ("token", "apiCa"):
        path = Path(config[name])
        info = path.stat()
        require(
            path.is_absolute()
            and stat.S_ISREG(info.st_mode)
            and info.st_uid == 0
            and not info.st_mode & (0o077 if name == "token" else 0o022),
            "protected Kubernetes API credential required",
        )
    for name in ("attestorSocket", "nodeOwnerSocket"):
        require(
            isinstance(config[name], str)
            and config[name].startswith("/var/run/")
            and config[name].endswith(".sock")
            and Path(config[name]).name.startswith(
                "attestor-v" if name == "attestorSocket" else "node-owner-v"
            ),
            "versioned pathname socket required",
        )
    for name in ("cniCN", "nodeOwnerCN"):
        require(
            isinstance(config[name], str) and config[name],
            "listener role CN required",
        )
    for name in ("ca", "certificate", "key"):
        path = Path(config[name])
        info = path.lstat()
        require(
            path.is_absolute()
            and path.resolve() == path
            and stat.S_ISREG(info.st_mode)
            and info.st_uid == 0
            and not info.st_mode & (0o077 if name == "key" else 0o022),
            "protected listener certificate required",
        )
    return config


def cri_module():
    loader = importlib.machinery.SourceFileLoader(
        "ads_cri", str(Path(__file__).with_name("ads-cri"))
    )
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


class CriObserver:
    def __init__(self, config):
        self.config = config
        self.deadline = time.monotonic() + 20
        self._context = None

    def tls_context(self):
        if self._context is None:
            # Verified TLS against the cluster CA. No kubeconfig, no kubectl,
            # no host kube tooling: authenticated HTTPS with the
            # service-account bearer token only.
            context = ssl.create_default_context(cafile=str(Path(self.config["apiCa"])))
            context.check_hostname = True
            context.verify_mode = ssl.CERT_REQUIRED
            self._context = context
        return self._context

    def api_get(self, path):
        remaining = min(4, self.deadline - time.monotonic())
        require(remaining > 0, "attestation deadline exceeded")
        request = urllib.request.Request(
            self.config["apiServer"] + path,
            headers={
                "Authorization": "Bearer " + Path(self.config["token"]).read_text().strip(),
                "Accept": "application/json",
            },
        )
        try:
            with urllib.request.urlopen(
                request, timeout=remaining, context=self.tls_context()
            ) as reply:
                payload = reply.read(1048577)
        except OSError:
            require(False, "observation failed")
        require(len(payload) <= 1048576, "observation too large")
        return json.loads(payload)

    def command(self, *args):
        remaining = min(4, self.deadline - time.monotonic())
        require(remaining > 0, "attestation deadline exceeded")
        # Host commands stay subprocesses. CRI responses never pass through here.
        with tempfile.TemporaryFile() as output:
            reply = subprocess.run(
                args,
                stdout=output,
                stderr=subprocess.DEVNULL,
                timeout=remaining,
                env={
                    "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
                    "LANG": "C",
                    "HOME": "/nonexistent",
                },
            )
            require(reply.returncode == 0 and output.tell() <= 1048576, "observation failed")
            output.seek(0)
            return json.load(output)

    def pods(self, selector=None):
        config = self.config
        path = (
            "/api/v1/namespaces/"
            + urllib.parse.quote(config["namespace"], safe="")
            + "/pods?fieldSelector="
            + urllib.parse.quote("spec.nodeName=" + config["node"], safe="")
        )
        if selector:
            path += "&labelSelector=" + urllib.parse.quote(selector, safe="")
        reply = self.api_get(path)
        require(not reply.get("metadata", {}).get("continue"), "incomplete Pod observation")
        return reply["items"]

    def cri(self):
        """Typed in-process CRI client: observer.cri().pods(), .inspectp(id),
        .containers(), .inspect(id). Returns the real ads-cri client so a
        wrong method or argument fails locally instead of at the RPC."""
        # Detect once. This is not a configured cri_endpoint.
        endpoint = self.config.get("cri_endpoint") or cri_module().detect()
        self.config["cri_endpoint"] = endpoint
        return cri_module().Cri(endpoint, min(self.deadline, time.monotonic() + 4))


def pod_identity(pod, config, component):
    meta, spec = pod["metadata"], pod["spec"]
    require(
        meta.get("namespace") == config["namespace"]
        and not meta.get("deletionTimestamp")
        and spec.get("nodeName") == config["node"]
        and not any(spec.get(name, False) for name in ("hostNetwork", "hostPID", "hostIPC"))
        and meta.get("labels", {}).get(COMPONENT) == component
        and pod.get("status", {}).get("phase") in ("Pending", "Running"),
        "Pod identity is not an active local pair member",
    )
    uid = meta["uid"]
    require(str(UUID(uid)) == uid, "canonical Pod UID required")
    labels = meta["labels"]
    for name in LABELS:
        require(str(UUID(labels[name])) == labels[name], "canonical pair labels required")
    return (uid, *(labels[name] for name in LABELS))


def select_pair(pods, uid, config):
    matches = [pod for pod in pods if pod.get("metadata", {}).get("uid") == uid]
    require(len(matches) == 1, "exact VM Pod missing")
    vm = matches[0]
    component = vm["metadata"].get("labels", {}).get(COMPONENT)
    require(component in ("ads-sandbox", "ads-sandbox-egress"), "not an execution or egress VM")
    side = "guest" if component == "ads-sandbox" else "egress"
    identity = pod_identity(vm, config, component)
    require(vm["spec"].get("runtimeClassName") == config[side + "_runtime"], "VM runtime mismatch")
    relay_component = "ads-sandbox-relay" if side == "guest" else "ads-sandbox-egress-relay"
    candidates = [
        pod
        for pod in pods
        if pod.get("metadata", {}).get("labels", {}).get(COMPONENT) == relay_component
        and all(pod["metadata"]["labels"].get(k) == vm["metadata"]["labels"][k] for k in LABELS)
    ]
    require(len(candidates) == 1, "exact local relay missing or ambiguous")
    relay = candidates[0]
    require(pod_identity(relay, config, relay_component)[1:] == identity[1:], "pair changed")
    require(relay["metadata"]["uid"] != uid, "relay aliases VM")
    require(not relay["spec"].get("runtimeClassName"), "relay must use ordinary node runtime")
    containers = relay["spec"].get("containers", [])
    require(
        len(containers) == 1
        and containers[0].get("name") == config["relay_container"]
        and containers[0].get("image") == config["relay_image"]
        and relay.get("status", {}).get("phase") == "Running",
        "relay image or process mismatch",
    )
    statuses = relay["status"].get("containerStatuses", [])
    require(
        len(statuses) == 1
        and statuses[0].get("name") == config["relay_container"]
        and "running" in statuses[0].get("state", {}),
        "relay container is not running",
    )
    container_id = statuses[0].get("containerID", "")
    require(
        re.fullmatch(cri_module().RUNTIME_ID, container_id),
        "exact containerd or cri-o ID required",
    )
    return vm, relay, side, container_id.split("://", 1)[1]


def runtime_identity(observer, relay, container_id):
    config, meta = observer.config, relay["metadata"]
    items = observer.cri().pods()
    matches = [
        item
        for item in items
        if item.get("metadata", {}).get("uid") == meta["uid"]
        and item["metadata"].get("namespace") == config["namespace"]
        and item.get("state") == "SANDBOX_READY"
    ]
    require(len(matches) == 1, "exact ready CRI sandbox required")
    sandbox = matches[0]
    require(re.fullmatch(r"[0-9a-f]{64}", sandbox["id"]), "invalid runtime sandbox ID")
    detail = observer.cri().inspectp(sandbox["id"])
    status = detail["status"]
    require(
        status["id"] == sandbox["id"]
        and status["state"] == "SANDBOX_READY"
        and status["metadata"]["uid"] == meta["uid"]
        and status["metadata"]["namespace"] == config["namespace"]
        and status["metadata"]["name"] == meta["name"],
        "runtime sandbox replaced",
    )
    container = observer.cri().inspect(container_id)
    status = container["status"]
    require(
        status["id"] == container_id
        and status["state"] == "CONTAINER_RUNNING"
        and status["metadata"]["name"] == config["relay_container"]
        and status["labels"].get("io.kubernetes.pod.uid") == meta["uid"]
        and status["labels"].get("io.kubernetes.pod.namespace") == config["namespace"]
        and status["imageRef"] == config["relay_image"]
        and container["info"].get("sandboxID") == sandbox["id"],
        "runtime container identity mismatch",
    )
    pids = (detail["info"]["pid"], container["info"]["pid"])
    require(all(type(pid) is int and pid > 1 for pid in pids), "invalid runtime PID")
    return sandbox["id"], pids


def ticks(pid):
    # Linux comm may contain spaces and parentheses; fields start after the last ')'.
    fields = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()
    require(fields[0] not in ("Z", "X"), "runtime process exited")
    return fields[19]


@contextlib.contextmanager
def processes(pids):
    with contextlib.ExitStack() as stack:
        originals = []
        for pid in pids:
            fd = os.pidfd_open(pid)
            stack.callback(os.close, fd)
            originals.append((pid, fd, ticks(pid)))

        def check():
            for pid, fd, start in originals:
                require(
                    not select.select([fd], [], [], 0)[0] and ticks(pid) == start,
                    "runtime process replaced",
                )

        check()
        yield check
        check()


def namespace_identity(fd):
    info = os.fstat(fd)
    require(fcntl.ioctl(fd, 0xB703) == 0x40000000, "network namespace required")
    return [info.st_dev, info.st_ino]


def host_facts(plugin, *, relay_uid, generation, sandbox_id, sandbox_pid, container_pid):
    """Journal and namespace inodes after the host mount namespace is current.

    No API call and no binding record. The caller enters that namespace.
    """
    private_path = f"/proc/{container_pid}/root/run/netns/private-{generation}"
    transport_path = f"/proc/{sandbox_pid}/ns/net"
    with processes((sandbox_pid, container_pid)):
        with (
            plugin.namespace(private_path) as private,
            plugin.namespace(transport_path) as transport,
            plugin.namespace(f"/proc/{container_pid}/ns/net") as container_net,
        ):
            private_id = namespace_identity(private)
            transport_id = namespace_identity(transport)
            require(transport_id == namespace_identity(container_net), "relay transport mismatch")
            require(private_id != transport_id, "private aliases transport")
            journal = plugin.read_record(
                Path(f"/proc/{container_pid}/root/run/relay-state/state.json")
            )
            require(
                journal.get("complete") is True
                and not journal.get("stopped")
                and journal.get("pod_uid") == relay_uid
                and journal.get("generation") == generation
                and journal.get("sandbox_id") == sandbox_id
                and journal.get("private") == private_id
                and journal.get("transport") == transport_id,
                "relay setup journal mismatch",
            )
    return {
        "journal": {
            "pod_uid": journal["pod_uid"],
            "generation": journal["generation"],
            "sandbox_id": journal["sandbox_id"],
        },
        "private": {"path": private_path, "identity": private_id},
        "transport": {"path": transport_path, "identity": transport_id},
    }


def binding_record(config, req, vm, relay, side, runtime, facts):
    journal = facts["journal"]
    return {
        "pod_uid": req["pod_uid"],
        "generation": journal["generation"],
        "sandbox_id": journal["sandbox_id"],
        "role": side,
        "ifname": req["ifname"],
        "network": config["network"],
        "relay_pod_uid": relay["metadata"]["uid"],
        "relay_runtime_id": runtime,
        "private": facts["private"],
        "transport": facts["transport"],
        "mtu": config["transport_mtu"] - 110,
        "address": "10.10.30.2/24" if side == "guest" else "10.10.30.1/24",
        "gateway": "10.10.30.1" if side == "guest" else None,
    }


def observe_binding(observer, plugin, req, host=None):
    config = observer.config
    require(req["network"] == config["network"], "network mismatch")
    first = select_pair(observer.pods(), req["pod_uid"], config)
    vm, relay, side, container = first
    require(req["ifname"] == ("eth0" if side == "guest" else "eth1"), "private interface mismatch")
    runtime, (sandbox_pid, container_pid) = runtime_identity(observer, relay, container)
    generation = vm["metadata"]["labels"]["ads.io/attachment-generation"]
    sandbox_id = vm["metadata"]["labels"]["ads.io/sandbox-id"]
    if host is None:
        facts = host_facts(
            plugin,
            relay_uid=relay["metadata"]["uid"],
            generation=generation,
            sandbox_id=sandbox_id,
            sandbox_pid=sandbox_pid,
            container_pid=container_pid,
        )
    else:
        # One socket call. The host reader owns the mount-namespace enter.
        facts = host(
            {
                "relay_pod_uid": relay["metadata"]["uid"],
                "generation": generation,
                "sandbox_id": sandbox_id,
                "sandbox_pid": sandbox_pid,
                "container_pid": container_pid,
            }
        )
    record = binding_record(config, req, vm, relay, side, runtime, facts)
    plugin.binding(record, req)
    # Repeat API and CRI after host facts, not from a cached watch.
    again = select_pair(observer.pods(), req["pod_uid"], config)
    require(
        again[0]["metadata"]["uid"] == vm["metadata"]["uid"]
        and again[1]["metadata"]["uid"] == relay["metadata"]["uid"]
        and again[2:] == first[2:]
        and all(again[0]["metadata"]["labels"][k] == vm["metadata"]["labels"][k] for k in LABELS),
        "pair changed during observation",
    )
    require(
        runtime_identity(observer, again[1], container) == (runtime, (sandbox_pid, container_pid)),
        "runtime changed during observation",
    )
    return record


def refresh(config_path, req, directory, plugin=None):
    """In-process path for release helpers. The host CNI uses the socket."""
    require(os.geteuid() == 0, "node-root attestor required")
    plugin = plugin or cni_module()
    config = validate(plugin.read_record(Path(config_path)))
    record = observe_binding(CriObserver(config), plugin, req)
    root = plugin.private_directory(directory)
    plugin.save_record(root / (req["pod_uid"] + ".json"), record)
    return record


def dial_node_owner(config, facts_request):
    """One TLS 1.3 round trip. The reply is host facts, not a binding."""
    path = config.get("nodeOwnerSocket")
    require(
        isinstance(path, str)
        and path.startswith("/var/run/node-owner-")
        and path.endswith(".sock"),
        "versioned node-owner socket required",
    )
    expected = config.get("nodeOwnerCN")
    require(isinstance(expected, str) and expected, "node-owner role CN required")
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    context.minimum_version = ssl.TLSVersion.TLSv1_3
    context.check_hostname = False
    context.verify_mode = ssl.CERT_REQUIRED
    context.load_verify_locations(cafile=config["ca"])
    context.load_cert_chain(config["certificate"], config["key"])
    raw = json.dumps(facts_request).encode()
    require(0 < len(raw) <= cni_module().LIMIT, "node-owner request exceeds bound")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(20)
        client.connect(path)
        with context.wrap_socket(client) as secured:
            peer = secured.getpeercert()
            require(cni_module().peer_cn(peer) == expected, "unexpected node-owner role")
            secured.sendall(len(raw).to_bytes(4, "big") + raw)
            size = int.from_bytes(secured.recv(4), "big")
            require(0 < size <= cni_module().LIMIT, "node-owner reply exceeds bound")
            chunks = bytearray()
            while len(chunks) < size:
                part = secured.recv(size - len(chunks))
                require(part, "truncated node-owner reply")
                chunks.extend(part)
    facts = json.loads(bytes(chunks))
    require(
        isinstance(facts, dict) and set(facts) == {"journal", "private", "transport"},
        "node-owner host facts required",
    )
    return facts


def serve_binding(config, connection):
    """API pair reads stay here. Host facts come from one node-owner call."""
    plugin = cni_module()
    connection.settimeout(20)
    size = int.from_bytes(connection.recv(4), "big")
    require(0 < size <= plugin.LIMIT, "attestor request exceeds bound")
    chunks = bytearray()
    while len(chunks) < size:
        part = connection.recv(size - len(chunks))
        require(part, "truncated attestor request")
        chunks.extend(part)
    req = json.loads(bytes(chunks))
    require(
        isinstance(req, dict) and set(req) == {"pod_uid", "network", "ifname"},
        "exact attestor request required",
    )

    def host(facts_request):
        return dial_node_owner(config, facts_request)

    record = observe_binding(CriObserver(config), plugin, req, host=host)
    payload = json.dumps(record).encode()
    require(len(payload) <= plugin.LIMIT, "attestor reply exceeds bound")
    connection.sendall(len(payload).to_bytes(4, "big") + payload)


def own_socket(path):
    """Unlink only this version's pathname, and only when connect fails."""
    require(
        isinstance(path, str) and path.startswith("/var/run/") and path.endswith(".sock"),
        "versioned pathname socket required",
    )
    try:
        probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            probe.settimeout(1)
            probe.connect(path)
            raise ValueError("versioned socket already bound")
        finally:
            probe.close()
    except FileNotFoundError:
        return
    except ConnectionRefusedError:
        os.unlink(path)
    except OSError as exc:
        if getattr(exc, "errno", None) != 111:
            raise
        os.unlink(path)


def listen(config):
    """Bind the attestor pathname socket. Do not enter the host mount namespace."""
    require(os.geteuid() == 0, "node-root attestor required")
    path = config["attestorSocket"]
    own_socket(path)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(path)
    os.chmod(path, 0o600)
    server.listen(4)
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    context.minimum_version = ssl.TLSVersion.TLSv1_3
    context.verify_mode = ssl.CERT_REQUIRED
    context.load_verify_locations(cafile=config["ca"])
    context.load_cert_chain(config["certificate"], config["key"])
    expected = config["cniCN"]
    while True:
        connection, _address = server.accept()
        try:
            connection.settimeout(10)
            secured = context.wrap_socket(connection, server_side=True)
            try:
                require(
                    cni_module().peer_cn(secured.getpeercert()) == expected,
                    "unexpected CNI client",
                )
                serve_binding(config, secured)
            finally:
                secured.close()
        except Exception:
            try:
                connection.close()
            except OSError:
                pass


def main():
    require(os.geteuid() == 0, "node-root attestor required")
    require(len(sys.argv) == 2, "one protected attestor listener configuration required")
    listen(cni_module().read_record(Path(sys.argv[1])))


if __name__ == "__main__":
    main()
