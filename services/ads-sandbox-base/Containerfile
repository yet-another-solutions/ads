# hadolint ignore=DL3007
FROM debian:latest AS pause-builder

ENV DEBIAN_FRONTEND=noninteractive

COPY services/ads-sandbox-base/scripts/pause.c /src/pause.c
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev \
    && gcc -O2 -static -o /pause /src/pause.c \
    && rm -rf /var/lib/apt/lists/*

# hadolint ignore=DL3007
FROM debian:latest

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bind9-dnsutils \
        ca-certificates \
        crun \
        curl \
        dnsutils \
        fuse-overlayfs \
        iproute2 \
        libcap2-bin \
        passt \
        podman \
        procps \
        python3 \
        python3-cryptography \
        slirp4netns \
        uidmap \
        util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && if ! id -u podman >/dev/null 2>&1; then \
           useradd --create-home --home-dir /home/podman --shell /bin/bash podman; \
       fi \
    && if ! grep -q '^podman:' /etc/subuid; then echo 'podman:100000:65536' >> /etc/subuid; fi \
    && if ! grep -q '^podman:' /etc/subgid; then echo 'podman:100000:65536' >> /etc/subgid; fi \
    && mkdir -p /etc/containers \
    && printf '%s\n' \
        '[storage]' \
        'driver = "overlay"' \
        'graphroot = "/session/outer-podman"' \
        'runroot = "/run/ads-podman"' \
        > /etc/containers/storage.conf

COPY --from=pause-builder /pause /usr/local/sbin/pause
COPY services/ads-sandbox-base/scripts/ads-sandbox-boot /usr/local/sbin/ads-sandbox-boot
COPY services/ads-sandbox-base/scripts/ads-session-exec /usr/local/sbin/ads-session-exec
COPY services/ads-sandbox-base/scripts/ads-session-device-check /usr/local/sbin/ads-session-device-check
COPY services/ads-sandbox-base/scripts/ads-sandbox-runtime /usr/local/sbin/ads-sandbox-runtime
COPY services/ads-sandbox-base/scripts/ads-sandbox-network /usr/local/sbin/ads-sandbox-network
COPY services/ads-sandbox-base/scripts/ads-agent-init /usr/local/sbin/ads-agent-init
COPY services/ads-sandbox-base/scripts/ads-sandbox-shutdown /usr/local/sbin/ads-sandbox-shutdown
COPY services/ads-sandbox-base/scripts/ads-sandbox-trust /usr/local/sbin/ads-sandbox-trust
COPY services/ads-sandbox-base/scripts/ads-install-egress-trust /usr/local/sbin/ads-install-egress-trust
COPY services/ads-sandbox-base/scripts/ads-sandbox-dnssec /usr/local/sbin/ads-sandbox-dnssec
COPY services/ads-sandbox-base/scripts/ads-install-dnssec-anchor /usr/local/sbin/ads-install-dnssec-anchor
COPY libraries/ads-commons/src/ads_commons/egress_trust.py /usr/local/lib/ads-trust/ads_egress_trust.py

RUN chmod 0644 /usr/local/sbin/ads-agent-init /usr/local/sbin/ads-sandbox-shutdown \
    && chmod 0755 /usr/local/sbin/ads-sandbox-dnssec \
    && chmod 0755 /usr/local/sbin/ads-sandbox-boot /usr/local/sbin/ads-session-exec /usr/local/sbin/ads-session-device-check /usr/local/sbin/ads-sandbox-runtime /usr/local/sbin/ads-sandbox-network /usr/local/sbin/ads-sandbox-trust /usr/local/sbin/pause \
    && test -x /usr/local/sbin/pause

ENTRYPOINT ["/usr/local/sbin/ads-sandbox-boot"]
