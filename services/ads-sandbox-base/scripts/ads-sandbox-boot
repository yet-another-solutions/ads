#!/bin/bash
set -euo pipefail

fail() {
  echo "ads-sandbox-boot: $*" >&2
  exit 1
}

podman_cmd() {
  /usr/local/sbin/ads-sandbox-runtime podman "$@"
}

green2() {
  local name
  ip -br link show lo | grep -q UP || fail "lo is not up"
  while read -r name _; do
    name=${name%%@*}
    [[ -n $name ]] || continue
    [[ $name == lo ]] || fail "unexpected up interface $name"
  done < <(ip -br link show up)
  if ip -4 route show default | grep -q .; then
    fail "default ipv4 route present"
  fi
  if ip -6 route show default | grep -q .; then
    fail "default ipv6 route present"
  fi
  if timeout 3 getent ahosts sandbox.internal >/dev/null 2>&1; then
    fail "sandbox.internal resolved"
  fi
}

case ${ADS_SANDBOX_NETWORK_MODE:-none} in
  none) green2;;
  private) /usr/local/sbin/ads-sandbox-network preflight;;
  *) fail "unsupported sandbox network mode";;
esac
if [[ -n ${ADS_CA_ATTEMPT:-} ]]; then
  /usr/local/sbin/ads-sandbox-trust mount
elif [[ -e /dev/ads-ca-public ]]; then
  fail "CA device without trusted attempt identity"
fi
/usr/local/sbin/ads-session-device-check
/usr/local/sbin/ads-sandbox-runtime prepare

mkdir -p /session
mount "$ADS_SESSION_DEVICE" /session
[[ -d /session/rootfs ]] || fail "/session/rootfs missing"
mkdir -p /session/outer-podman /run/ads-podman
chown podman:podman /session /session/outer-podman /run/ads-podman

if podman_cmd container exists dev-sandbox; then
  contract=$(podman_cmd inspect --format '{{index .Config.Labels "ads.io/runtime-contract"}}' dev-sandbox)
  [[ $contract == nested-v1 ]] || fail "incompatible persisted dev-sandbox; explicit migration required (no automatic removal)"
  podman_cmd start dev-sandbox
else
  chown -R podman:podman /session/rootfs
  # Start disconnected; private mode hands off the sole NIC after identity checks.
  # Native overlay storage does not require a FUSE device.
  # Use separate options: a colon-joined value does not make cgroupfs writable.
  unmask=()
  for path in /sys/fs/cgroup /proc/acpi /proc/keys /proc/timer_list /proc/bus /proc/fs /proc/irq /proc/sys; do
    unmask+=(--security-opt "unmask=$path")
  done
  podman_cmd create --name dev-sandbox --network=none --cgroupns=private --cgroup-parent=/ads-budget/podman --label ads.io/runtime-contract=nested-v1 "${unmask[@]}" --rootfs /session/rootfs /bin/sleep infinity
  podman_cmd start dev-sandbox
fi

if [[ ${ADS_SANDBOX_NETWORK_MODE:-none} == private ]]; then
  /usr/local/sbin/ads-sandbox-network attach
  # The only resolver is the paired egress. Mutable inner software still runs
  # rootless; guest root never follows inner paths or executes inner binaries.
  podman_cmd exec dev-sandbox /bin/sh -ec \
    'printf "nameserver 10.10.30.1\n" > /etc/resolv.conf'
fi

if [[ -n ${ADS_CA_ATTEMPT:-} ]]; then
  # Only the minted public CA, never parent/company bundles. Mutable inner
  # software runs through rootless Podman, never chroot/exec as guest root.
  /usr/local/sbin/ads-sandbox-trust certificate | podman_cmd exec -i dev-sandbox \
    /bin/sh -ec 'mkdir -p /usr/local/share/ca-certificates; cat > /usr/local/share/ca-certificates/ads-egress.crt; update-ca-certificates'
fi

# Keep initialization code in the base image, never in the writable rootfs.
# Missing/broken inner software fails startup; do not repair agent modifications.
podman_cmd exec -i dev-sandbox python3 - < /usr/local/sbin/ads-agent-init \
  || fail "agent cgroup initialization failed"

# Readiness means the agent leaf and controllers exist, not merely that Podman
# started a process. This runs on both create and resume.
ready=false
for _ in {1..30}; do
  if podman_cmd exec dev-sandbox python3 -c '
from pathlib import Path
cg = Path("/sys/fs/cgroup")
assert Path("/proc/self/cgroup").read_text().strip() == "0::/agent"
assert {"cpu", "memory", "pids"} <= set((cg / "cgroup.subtree_control").read_text().split())
'; then
    ready=true
    break
  fi
  sleep 1
done
[[ $ready == true ]] || fail "agent cgroup initialization failed"
touch /run/ads-sandbox-ready
exec capsh --drop=cap_sys_admin,cap_net_admin,cap_sys_ptrace -- -c 'exec /usr/local/sbin/pause'
