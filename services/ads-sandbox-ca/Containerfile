FROM python:3.12-slim-bookworm AS builder
COPY --from=ghcr.io/astral-sh/uv:0.10.12 /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv
COPY pyproject.toml README.md uv.lock /app/
COPY libraries /app/libraries
COPY services /app/services
RUN uv sync --frozen --package ads-sandbox-ca --no-dev --no-default-groups --no-editable

FROM python:3.12-slim-bookworm
RUN apt-get update \
    && apt-get install -y --no-install-recommends e2fsprogs util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /outputs/public /outputs/private
COPY --from=builder /app /app
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1
WORKDIR /app
CMD ["python", "-m", "ads_sandbox_ca"]
