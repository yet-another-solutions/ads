FROM python:3.12-slim-trixie AS builder
COPY --from=ghcr.io/astral-sh/uv:0.10.12 /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv
COPY pyproject.toml README.md uv.lock /app/
COPY libraries /app/libraries
COPY services /app/services
RUN uv sync --frozen --package ads-sandbox-egress --no-dev --no-default-groups --no-editable

FROM debian:trixie-slim AS native
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /native
# Native ABI and package digest are verified pins from the genuine ECH proof.
# This v1 artifact is amd64 only; other architectures require their own proof.
RUN test "$(dpkg --print-architecture)" = amd64 \
    && curl --fail --show-error --location \
       --output libssl.deb https://deb.debian.org/debian/pool/main/o/openssl/libssl4_4.0.2-1_amd64.deb \
    && echo "1e265574c02f4918092d2f09e63cf368b21f15108b667790633f038717ded260  libssl.deb" | sha256sum --check \
    && dpkg-deb --extract libssl.deb extracted \
    && mkdir -p /opt/ads-openssl/lib \
    && cp extracted/usr/lib/x86_64-linux-gnu/libcrypto.so.4 \
          extracted/usr/lib/x86_64-linux-gnu/libssl.so.4 /opt/ads-openssl/lib/ \
    && rm -rf libssl.deb extracted

FROM python:3.12-slim-trixie
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates e2fsprogs iproute2 libnginx-mod-http-lua libzstd1 nftables nginx procps util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/ads-egress /app \
    && chmod 0700 /run/ads-egress
COPY --from=native /opt/ads-openssl /opt/ads-openssl
COPY --from=builder /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LD_LIBRARY_PATH=/opt/ads-openssl/lib \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_DIR=/etc/ssl/certs \
    OPENSSL_CONF=/dev/null
WORKDIR /app
RUN python -c "from pathlib import Path; from ads_sandbox_egress.tls import TLSLibrary; TLSLibrary(Path('/opt/ads-openssl/lib'))"
CMD ["python", "-m", "ads_sandbox_egress"]
