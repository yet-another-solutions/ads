# hadolint ignore=DL3007
FROM debian:latest

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        e2fsprogs \
        python3 \
        tar \
        util-linux \
        zstd \
    && rm -rf /var/lib/apt/lists/*

COPY rootfs.tar.zst /ci/rootfs.tar.zst
COPY scripts/ads-sandbox-golden /usr/local/sbin/ads-sandbox-golden
COPY scripts/ads-session-device-check /usr/local/sbin/ads-session-device-check

RUN chmod 0755 /usr/local/sbin/ads-sandbox-golden /usr/local/sbin/ads-session-device-check \
    && test -s /ci/rootfs.tar.zst \
    && test "$(stat -c '%s' /ci/rootfs.tar.zst)" -lt 1073741824

ENTRYPOINT ["/usr/local/sbin/ads-sandbox-golden"]
