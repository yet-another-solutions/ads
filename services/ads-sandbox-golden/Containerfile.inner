FROM debian:latest

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        bind9-dnsutils \
        ca-certificates \
        crun \
        curl \
        dnsutils \
        fuse-overlayfs \
        passt \
        podman \
        python3 \
        python3-pip \
        python3-venv \
        slirp4netns \
        uidmap \
        wget \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /bin/bash /bin/sh \
    && mkdir -p /workspace /etc/containers \
    && if ! grep -q '^root:' /etc/subuid; then echo 'root:100000:65536' >> /etc/subuid; fi \
    && if ! grep -q '^root:' /etc/subgid; then echo 'root:100000:65536' >> /etc/subgid; fi \
    && printf '%s\n' \
        '[containers]' \
        'netns = "host"' \
        'utsns = "host"' \
        'ipcns = "host"' \
        > /etc/containers/containers.conf
